# ─────────────────────────────────────────────────────────────────────────────
# Variáveis de ambiente — PRODUÇÃO (backend Lumin PDV)
#
# No Render, estas variáveis são preenchidas no painel (as marcadas com
# "sync: false" no render.yaml). Este arquivo é só um MODELO/documentação —
# NÃO coloque segredos reais aqui e NÃO faça commit de um .env com valores.
# ─────────────────────────────────────────────────────────────────────────────

# Banco Postgres — crie grátis no Neon (https://neon.tech).
# Copie a "connection string" e ADICIONE ?sslmode=require no final.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Segurança — em produção use um segredo forte (o Render gera automaticamente
# via generateValue no render.yaml). Nunca reutilize o valor de desenvolvimento.
JWT_SECRET="troque-por-um-segredo-forte-e-aleatorio"
JWT_EXPIRES_IN="8h"
INTERNAL_WEBHOOK_TOKEN="troque-por-um-token-aleatorio"

NODE_ENV=production
# PORT é injetada automaticamente pelo Render — não defina manualmente.

# CORS — domínios do front que podem chamar a API (separados por vírgula).
# Se usar o proxy /api da Netlify (recomendado), pode deixar VAZIO.
# Ex.: https://lumin-pdv.netlify.app,https://app.seudominio.com.br
FRONTEND_URL=""

# Uploads (disco efêmero no plano free do Render — some a cada deploy).
UPLOAD_PATH="./uploads"
MAX_FILE_SIZE_MB=10

# ── Mercado Pago (assinaturas) ───────────────────────────────────────────────
# Comece em "simulado" para testar sem cobrança real.
# Em produção: MP_MODO="producao" + MP_ACCESS_TOKEN de PRODUÇÃO (APP_USR-...)
# + FRONT_URL público https (o MP não aceita localhost).
MP_MODO="simulado"
MP_ACCESS_TOKEN=""
FRONT_URL="https://lumin-pdv.netlify.app"

# ── E-mail transacional (Resend) ─────────────────────────────────────────────
# Comece em "simulado" (loga no console).
# Em produção: MAIL_MODO="producao" + RESEND_API_KEY + MAIL_FROM de um
# domínio VERIFICADO no Resend (https://resend.com).
MAIL_MODO="simulado"
RESEND_API_KEY=""
MAIL_FROM="Lumin PDV <onboarding@resend.dev>"

# URL do sistema (link de login no e-mail de boas-vindas).
APP_URL="https://lumin-pdv.netlify.app"

# ── Assistente IA "Lu" ───────────────────────────────────────────────────────
# IA_MODO: "simulado" (resumo local, sem custo) | "gemini" (Google Gemini Flash).
# Para ligar a IA de verdade: IA_MODO="gemini" + GEMINI_API_KEY.
IA_MODO="simulado"
GEMINI_API_KEY=""           # crie em https://aistudio.google.com/apikey
GEMINI_MODEL="gemini-2.0-flash"
